{
  "name": "zdl-experiments",
  "version": "0.1.0",
  "description": "Knot-theoretic models (tangles, braids, links) of two-dancer hand connections, extending the set-partition model from zacksdancelab.com with spatial entanglement data.",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "enumerate": "npm run build:lib && node dist/enumerate/run.js",
    "build:lib": "tsc -p tsconfig.json",
    "build": "npm run build:lib && npm run build --workspace web",
    "dev": "npm run dev --workspace web",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmaril/zdl-experiments.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
